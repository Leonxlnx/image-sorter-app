<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (cloud + device-transfer backup).
    Persist user settings and folder list, drop per-session reviewed state so a
    restore on a new device starts clean.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <exclude domain="file" path="datastore/reviewed.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <exclude domain="file" path="datastore/reviewed.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
